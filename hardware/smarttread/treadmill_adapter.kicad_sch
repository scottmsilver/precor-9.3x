	)
	(text "TREADMILL BUS PINOUT:\n  Pin 1: GND\n  Pin 2: +8V\n  Pin 3: Motor TX (data) -- passthrough + tap\n  Pin 4: Safety switch -- passthrough\n  Pin 5: +8V\n  Pin 6: Console TX (data) -- CUT, routed thru Pi\n  Pin 7: GND\n  Pin 8: +8V"
		(exclude_from_sim no)
		(at 50.8 132.08 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "bbbb0001-0001-0001-0001-000000000001")
	)
	(text "PI GPIO MAPPING:\n  Pi Pin 2  (5V)      <- Pololu VOUT\n  Pi Pin 6  (GND)     <- Treadmill GND\n  Pi Pin 8  (GPIO14)  = UART0 TXD -> J2 Pin 6 (to motor)\n  Pi Pin 10 (GPIO15)  = UART0 RXD <- J1 Pin 6 (from console)\n  Pi Pin 29 (GPIO5)   = UART3 RXD <- Pin 3 tap (from motor)\n\nRequires: dtoverlay=uart3 in /boot/config.txt"
		(exclude_from_sim no)
		(at 152.4 170.18 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "bbbb0002-0002-0002-0002-000000000001")
	)
	(text "POWER PATH:\n  Treadmill +8V (pins 2/5/8)\n    -> U1 VIN (Pololu D24V10F5)\n    -> U1 VOUT = 5V @ 1A\n    -> Pi 5V rail (header pin 2)\n\n  No external power needed."
		(exclude_from_sim no)
		(at 165.1 43.18 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "bbbb0003-0003-0003-0003-000000000001")
	)
	(text "NOTE: Pin 6 is CUT between J1 and J2.\nConsole TX enters Pi on UART0 RXD.\nPi proxy re-transmits on UART0 TXD to motor.\nPin 3 (Motor TX) passes through uncut,\nbut is tapped to Pi UART3 RXD for monitoring.\n\n8V TTL connects directly to Pi GPIO.\n(Tested -- Pi survives 8V on input pins.)"
		(exclude_from_sim no)
		(at 152.4 88.9 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "bbbb0004-0004-0004-0004-000000000001")
	)
