# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# Logs (large files)
*.jsonl
*.log

# CSVs except logic-analyzer captures (cpp/captures/ — tracked for analysis)
# and fab order files (BOM/CPL are the deliverable, not data exhaust)
*.csv
!cpp/captures/*.csv
!hardware/Esp32Tap/bom/*.csv

# Editor backups
*~
*.swp
*.swo

# OS files
.DS_Store

# Secrets — never commit
.gemini_key
.env
.env.*
!.env.example
*.pem
cert.pem
key.pem
*.jks
*.keystore

# Runtime data (regenerated per device/run)
program_history.json
saved_workouts.json
run_history.json
user_profile.json
background_advice.json
*.migrated
treadmill.db
treadmill.db-shm
treadmill.db-wal

# C++ build artifacts
*.o
*.d
*.gcda
*.gcno
*.gcov
cpp/tests/test_*_cov

# Build staging directory (matches build/ at any depth, incl. kotlin/app/build)
build/

# Rust build artifacts
**/target/

# Analysis/experimental scripts (not part of main tools)
analysis/

# Screenshots (dev artifacts; docs/screenshots is tracked for README)
screenshots/
!docs/screenshots/

# Node modules
node_modules/

# Android / Kotlin
kotlin/.gradle/
kotlin/.cxx/
kotlin/local.properties
*.apk
*.aab

# iOS build artifacts
ios/Treddy.xcodeproj/xcuserdata/
ios/DerivedData/

# KiCad (track the design: .kicad_pro/_sch/_pcb; ignore per-user + autosave)
*.kicad_prl
*-backups/
*.lck
fp-info-cache

# Worktree environment (per-worktree ports)
worktree.env
.worktrees/

# Local tool state (Claude Code, gstack, superpowers, codex — never tracked here)
.claude/
.gstack/
.superpowers/
.codex

# Beads: it self-manages .beads/.gitignore (ignores the SQLite db + daemon
# runtime, tracks the JSONL issue store + .beads/.gitignore itself). The only
# rule needed here is to re-include the issue store, since the global *.jsonl
# log rule above would otherwise swallow it.
!.beads/*.jsonl

# Provisioning secrets (operator-supplied + prepare-sd.sh output, never commit)
provisioning/dietpi/secrets.env*
!provisioning/dietpi/secrets.env.example
provisioning/dietpi/dietpi-wifi.txt*
!provisioning/dietpi/dietpi-wifi.txt.example

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
